# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
/dist/

# Scratch / temp working files
.scratch/

# Training run artifacts (HF cache, datasets, checkpoints, exports, logs)
# — default $STOIC_TRAIN_HOME, see training/win_cuda/README.md
.artifacts/

# Large media — kept in Google Drive, not git
*.mp4
*.mov
*.mkv
*.m4v
*.webm
*.wav
*.mp3

# Keyframe images — regenerable by edu/pipeline
edu/derived/**/keyframes/

# Market data — kept in Google Drive, not git
data/historical/*.dbn
data/historical/*.dbn.zst

# Secrets / credentials
.env
.env.*
*.pem
*.key
client_secret*.json
credentials*.json
service_account*.json
token*.json

# OS
.DS_Store

# Video archive — kept in Google Drive, restored via ./unzip_videos.sh
videos.zip

# SP5 static SPA dependencies and generated verification output
web/node_modules/
web/dist/
web/coverage/
web/playwright-report/
web/test-results/
web/*.tsbuildinfo
